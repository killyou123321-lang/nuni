rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: read by anyone authenticated, write only by owner
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // User categories: only owner can read/write
    match /userCategories/{userId}/categories/{catId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Recipes:
    // - public recipes: anyone authenticated can read
    // - followers recipes: author's followers can read
    // - private recipes: only author can read
    // - create: authenticated users
    // - update likes/savedBy/favoritedBy: authenticated users
    // - update other fields / delete: only author
    match /recipes/{recipeId} {
      allow read: if request.auth != null && (
        resource.data.visibility == 'public' ||
        resource.data.authorId == request.auth.uid ||
        (resource.data.visibility == 'followers' &&
         request.auth.uid in get(/databases/$(database)/documents/users/$(resource.data.authorId)).data.followers)
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.authorId == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'savedBy', 'favoritedBy']))
      );
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
  }
}
